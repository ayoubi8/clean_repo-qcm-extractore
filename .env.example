#  QCM EXTRACTOR â€” .env configuration template
#  Edit only this file to change models. Never touch .py files.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Deployment URLs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The public URL of your frontend (used by backend for OAuth redirect)
# On HF Spaces set this as a Space Secret named FRONTEND_URL
FRONTEND_URL=https://qcm-extractor-frontend.vercel.app


# â”€â”€ Core API (ONE key used for ALL steps) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
OPENROUTER_API_KEY=your_openrouter_api_key_here

# â”€â”€ Step 1: OCR Vision (image â†’ text) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP1_MODEL=qwen/qwen3-vl-30b-a3b-instruct
STEP1_FALLBACK_MODEL=qwen/qwen-2.5-vl-7b-instruct:free
STEP1_MAX_TOKENS=15000

# â”€â”€ Step 1.5: Text Split Fixer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP1_5_MODEL=google/gemma-3-27b-it:free
STEP1_5_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
STEP1_5_MAX_TOKENS=8000

# â”€â”€ Step 1.6: Intelligent OCR Text Corrector â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP1_6_MODEL=meta-llama/llama-3.3-70b-instruct
STEP1_6_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
STEP1_6_MAX_TOKENS=4000

# â”€â”€ Step 2: QCM Extraction â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP2_MODEL=google/gemini-2.5-flash-lite-preview-09-2025
STEP2_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
STEP2_MAX_TOKENS=40000

# â”€â”€ Step 3: Metadata Detection â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP3_MODEL=google/gemma-3-27b-it
STEP3_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
STEP3_MAX_TOKENS=4000

# â”€â”€ Clinical Case Checker: Phase 1 verification (cheap/fast model) â”€â”€
# Double-checks every cascaded Cas Clinique link, one question per QCM.
# Independent from Step 2/3 â€” use a cheap, low-latency model here.
CC_CHECKER_MODEL=inception/mercury-2.5-preview
CC_CHECKER_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
CC_CHECKER_MAX_TOKENS=500

# â”€â”€ Step 6: Correction Page Parser (text tables) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP6_TEXT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
STEP6_TEXT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
STEP6_TEXT_MAX_TOKENS=4000

# â”€â”€ Step 6: All-Pages Scan (big context window) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP6_ALL_PAGES_MODEL=google/gemini-2.5-flash-lite-preview-09-2025
STEP6_ALL_PAGES_FALLBACK_MODEL=google/gemini-2.0-flash-001
STEP6_ALL_PAGES_MAX_TOKENS=40000

# â”€â”€ Step 6: AI-Knowledge Mode (DeepSeek reasoning) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP6_AI_MODEL=deepseek/deepseek-r1-distill-llama-70b
STEP6_AI_FALLBACK_MODEL=deepseek/deepseek-r1
STEP6_AI_MAX_TOKENS=4000

# â”€â”€ Step 7: Categorization â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STEP7_MODEL=meta-llama/llama-3.3-70b-instruct
STEP7_FALLBACK_MODEL=google/gemini-2.0-flash-lite-001
STEP7_MAX_TOKENS=4000

# â”€â”€ Caching â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ENABLE_CACHING=true

# â”€â”€ Step 8: QCM Similarity Matcher â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Path to your reference database (.xlsx or .json)
REFERENCE_DB_PATH=path_to_reference_db
MATCH_THRESHOLD=0.75

# Similarity mode: text_only | full | weighted
MATCH_MODE=text_only

# Weights used only in 'weighted' mode (must sum to 1.0)
MATCH_TEXT_WEIGHT=0.7
MATCH_CORRECTION_WEIGHT=0.3

# XLSX report color thresholds (similarity score boundaries)
MATCH_COLOR_GREEN=0.90
MATCH_COLOR_YELLOW=0.75


# -- Google Drive link import (POST /projects/{name}/pdf-from-drive) --
# Feature flag. Set to true to enable the 'Import from a Google Drive link' option.
GDRIVE_IMPORT_ENABLED=false
# Hard download-size cap in bytes (streamed; Content-Length is never trusted).
MAX_DRIVE_PDF_BYTES=209715200

# ----- AUTO RUN BATCH (multi-PDF) -------------------------------------------
# Third Switch Project tab: run steps 1-2-6 over up to 10 Drive/local PDFs.
# AUTORUN_BATCH_ENABLED  = the feature flag (routes 404 and the UI hides the tab when false)
# AUTORUN_BATCH_CONCURRENCY = PDFs running at the same time (default 5, queue-based)
# MAX_AUTORUN_BATCH_FILES = hard cap per batch (default 10)
AUTORUN_BATCH_ENABLED=true
AUTORUN_BATCH_CONCURRENCY=5
MAX_AUTORUN_BATCH_FILES=10



# ----- STEP-RESULTS CACHE (Phase 5 — history-progress-cache plan) -------------
# STEP_CACHE_TTL = seconds a step's status/output summary stays cached.
# Single knob for the server AND the batch-view client; clamped to 120-300s.
# Correctness comes from explicit invalidation (runs, deletes, sheets sync) -
# the TTL is only the safety net.
STEP_CACHE_TTL=180
